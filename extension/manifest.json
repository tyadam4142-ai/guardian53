{
  "manifest_version": 3,
  "name": "Guardian 53 \u2014 Parent Control",
  "short_name": "Guardian 53",
  "version": "0.1.0",
  "description": "Transparent family-managed website filtering and parent-approved access requests.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://guardian53.dynamicrobotics53.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Guardian 53",
    "default_popup": "parent/parent_dashboard.html"
  },
  "options_page": "parent/parent_dashboard.html",
  "web_accessible_resources": [
    {
      "resources": [
        "child/blocked.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}

{
  "name": "guardian53-cloudflare-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create guardian53-prod",
    "db:migrate:local": "wrangler d1 migrations apply guardian53-prod --local",
